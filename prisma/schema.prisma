// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PayBasis {
  HOURLY
  /// Rate is per full day, prorated by regular hours worked (rate / regular hours cap per hour).
  DAILY
  /// Full flat daily rate for any day worked, regardless of hours (packing staff/helpers).
  FLAT_DAILY
  /// Production staff: the daily rate depends on that date's operation day
  /// (Cooking vs Jar Filling rate in Settings), prorated by regular hours worked.
  OPERATION_DAY
}

enum PunchType {
  IN
  OUT
  BREAK_START
  BREAK_END
}

enum DayStatusType {
  PAID_LEAVE
  UNPAID_ABSENCE
}

enum PayPeriodStatus {
  OPEN
  FINALIZED
}

enum PayslipStatus {
  DRAFT
  FINALIZED
}

enum InventoryCategory {
  INGREDIENT
  PRODUCT
  PACKAGING
}

enum StockMovementType {
  IN
  OUT
}

enum TaskAssignmentStatus {
  PENDING
  DONE
}

enum SanitationAssignmentStatus {
  PENDING
  DONE
}

enum InspectionResult {
  PASS
  FAIL
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum AdminRole {
  OWNER
  SUPERVISOR
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(OWNER)
  /** True unless access has been revoked -- kept rather than deleted, since
   * audit log entries and other history reference this account. */
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())

  /** Links a SUPERVISOR login to the Employee record for the same person
   * (so they also punch in/out normally). Null for the OWNER account. */
  employeeId String?   @unique
  employee   Employee? @relation(fields: [employeeId], references: [id])

  createdPunches   Punch[]     @relation("PunchCreatedByAdmin")
  finalizedPeriods PayPeriod[] @relation("PayPeriodFinalizedByAdmin")
  auditLogEntries  AuditLog[]  @relation("AuditLogActor")
  stockMovements   StockMovement[]  @relation("StockMovementCreatedByAdmin")
  assignedTasks    TaskAssignment[] @relation("TaskAssignmentAssignedByAdmin")
  assignedSanitation  SanitationAssignment[] @relation("SanitationAssignmentAssignedByAdmin")
  inspectedSanitation SanitationAssignment[] @relation("SanitationAssignmentInspectedByAdmin")
}

model Employee {
  id         String   @id @default(cuid())
  name       String
  pinHash    String
  payBasis   PayBasis
  payRate    Decimal  @db.Decimal(10, 2)
  active     Boolean  @default(true)
  dateHired  DateTime @db.Date
  photoPath  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  adminAccount AdminUser?

  punches               Punch[]
  dayStatuses           DayStatus[]
  payslips              Payslip[]
  taskAssignments       TaskAssignment[]
  sanitationAssignments SanitationAssignment[]
  lateDayActions        LateDayAction[]
}

model Device {
  id        String   @id @default(cuid())
  label     String
  createdAt DateTime @default(now())

  punches Punch[]
}

model Punch {
  id        String    @id @default(cuid())
  employeeId String
  employee  Employee  @relation(fields: [employeeId], references: [id])
  timestamp DateTime  @default(now())
  type      PunchType
  photoPath String?
  deviceId  String?
  device    Device?   @relation(fields: [deviceId], references: [id])

  /** True once this punch has been superseded by an edit, or manually voided (a "deletion"). Never hard-deleted, and excluded from payroll pairing. */
  voided                Boolean  @default(false)

  isCorrection          Boolean  @default(false)
  correctedFromPunchId  String?
  correctedFromPunch    Punch?   @relation("PunchCorrection", fields: [correctedFromPunchId], references: [id])
  corrections           Punch[]  @relation("PunchCorrection")
  correctionReason      String?

  createdByAdminId String?
  createdByAdmin    AdminUser? @relation("PunchCreatedByAdmin", fields: [createdByAdminId], references: [id])

  createdAt DateTime @default(now())

  @@index([employeeId, timestamp])
}

model DayStatus {
  id         String        @id @default(cuid())
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id])
  date       DateTime      @db.Date
  status     DayStatusType
  note       String?
  setByAdminId String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([employeeId, date])
}

model PayPeriod {
  id          String          @id @default(cuid())
  startDate   DateTime        @db.Date
  endDate     DateTime        @db.Date
  status      PayPeriodStatus @default(OPEN)
  finalizedAt DateTime?
  finalizedByAdminId String?
  finalizedByAdmin   AdminUser? @relation("PayPeriodFinalizedByAdmin", fields: [finalizedByAdminId], references: [id])
  createdAt   DateTime        @default(now())

  payslips Payslip[]

  @@unique([startDate, endDate])
}

model Payslip {
  id            String        @id @default(cuid())
  employeeId    String
  employee      Employee      @relation(fields: [employeeId], references: [id])
  payPeriodId   String
  payPeriod     PayPeriod     @relation(fields: [payPeriodId], references: [id])
  regularHours  Decimal       @db.Decimal(10, 2)
  overtimeHours Decimal       @db.Decimal(10, 2)
  basePay       Decimal       @db.Decimal(10, 2)
  grossPay      Decimal       @db.Decimal(10, 2)
  status        PayslipStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  /** Per-day-type pay lines ({ lines: [{ label, days, rate, amount }] }) for
   * FLAT_DAILY / OPERATION_DAY employees, frozen once the payslip is finalized. */
  payBreakdown  Json?

  adjustments PayslipAdjustment[]

  @@unique([employeeId, payPeriodId])
}

model PayslipAdjustment {
  id        String   @id @default(cuid())
  payslipId String
  payslip   Payslip  @relation(fields: [payslipId], references: [id])
  label     String
  amount    Decimal  @db.Decimal(10, 2)
  note      String?
  createdAt DateTime @default(now())

  taskAssignment TaskAssignment?
  sanitationAssignment SanitationAssignment?
  lateDayAction        LateDayAction?
}

/** What an admin decided about a suggested late-arrival deduction for one
 * employee on one day: applied to a payslip (payslipAdjustmentId set) or
 * skipped (dismissed). A day with no row -- or a row whose adjustment was
 * later removed -- is suggested again. */
model LateDayAction {
  id                  String             @id @default(cuid())
  employeeId          String
  employee            Employee           @relation(fields: [employeeId], references: [id])
  date                DateTime           @db.Date
  dismissed           Boolean            @default(false)
  payslipAdjustmentId String?            @unique
  payslipAdjustment   PayslipAdjustment? @relation(fields: [payslipAdjustmentId], references: [id])
  createdAt           DateTime           @default(now())

  @@unique([employeeId, date])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorAdminId String?
  actorAdmin   AdminUser? @relation("AuditLogActor", fields: [actorAdminId], references: [id])
  action      String
  targetTable String
  targetId    String
  beforeJson  Json?
  afterJson   Json?
  reason      String?
  timestamp   DateTime @default(now())

  @@index([targetTable, targetId])
}

model Settings {
  id                    Int          @id @default(1)
  otMultiplier          Decimal      @default(1.25) @db.Decimal(4, 2)
  gracePeriodMinutes    Int          @default(10)
  unpaidLunchMinutes    Int          @default(60)
  regularHoursCapPerDay Decimal      @default(8) @db.Decimal(4, 2)
  requirePhotoOnPunch   Boolean      @default(true)
  shiftStartTime        String       @default("08:00")
  shiftEndTime          String       @default("17:00")
  payPeriodStartDay     Int          @default(1) // 1 = Monday (ISO weekday)
  /** Which of the two daily operations the kiosk is showing today. Only
   * authoritative when operationDayOverrideDate is today -- otherwise it's
   * stale and the day is derived from the weekday rotation instead. See
   * getOperationDay() in src/lib/settings.ts. */
  operationDay             OperationDay @default(COOKING)
  /** The calendar date (Asia/Manila) that operationDay was last manually
   * set for. Null, or not today, means no manual override is in effect. */
  operationDayOverrideDate DateTime?    @db.Date
  /** Pay per day worked for OPERATION_DAY employees, on a Cooking day / Jar
   * Filling day. Half days are handled by an admin "Half day" deduction. */
  cookingDayRate           Decimal      @default(400) @db.Decimal(10, 2)
  jarFillingDayRate        Decimal      @default(350) @db.Decimal(10, 2)
  updatedAt                DateTime     @updatedAt
}

/** The operation day that was actually in effect on a given date, recorded
 * whenever a supervisor toggles it at the kiosk (or an owner corrects it on
 * payroll). Dates with no row fall back to the weekday rotation. Payroll reads
 * this so a past date's pay rate doesn't depend on today's kiosk state. */
model OperationDayLog {
  date         DateTime     @id @db.Date
  operationDay OperationDay
  updatedAt    DateTime     @updatedAt
}

enum OperationDay {
  COOKING
  JAR_FILLING
}

/** A one-off shift start/end time for a specific date (e.g. work started late
 * because ingredients arrived late), applying to everyone that day. Only
 * affects the Late/Undertime flags -- pay is always actual hours worked. */
model ShiftOverride {
  id             String   @id @default(cuid())
  date           DateTime @unique @db.Date
  shiftStartTime String
  shiftEndTime   String
  setByAdminId   String?
  createdAt      DateTime @default(now())
}

model InventoryItem {
  id                String            @id @default(cuid())
  name              String
  category          InventoryCategory
  unit              String
  quantity          Decimal           @default(0) @db.Decimal(12, 2)
  lowStockThreshold Decimal           @default(0) @db.Decimal(12, 2)
  active            Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  movements StockMovement[]
}

model StockMovement {
  id        String             @id @default(cuid())
  itemId    String
  item      InventoryItem      @relation(fields: [itemId], references: [id])
  type      StockMovementType
  quantity  Decimal            @db.Decimal(12, 2)
  reason    String
  createdByAdminId String?
  createdByAdmin   AdminUser?  @relation("StockMovementCreatedByAdmin", fields: [createdByAdminId], references: [id])
  createdAt DateTime           @default(now())

  @@index([itemId, createdAt])
}

model TaskTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  assignments TaskAssignment[]
}

model TaskAssignment {
  id          String               @id @default(cuid())
  templateId  String
  template    TaskTemplate         @relation(fields: [templateId], references: [id])
  employeeId  String
  employee    Employee             @relation(fields: [employeeId], references: [id])
  date        DateTime             @db.Date
  bonusAmount Decimal?             @db.Decimal(10, 2)
  status      TaskAssignmentStatus @default(PENDING)
  completedAt DateTime?

  assignedByAdminId String?
  assignedByAdmin   AdminUser?     @relation("TaskAssignmentAssignedByAdmin", fields: [assignedByAdminId], references: [id])

  /** Set once an admin turns this bonus into a real PayslipAdjustment, so it can never be suggested or applied twice. */
  payslipAdjustmentId String?             @unique
  payslipAdjustment   PayslipAdjustment?  @relation(fields: [payslipAdjustmentId], references: [id])
  /** True once an admin has declined this bonus, so it stops being suggested. */
  bonusDismissed      Boolean             @default(false)

  createdAt DateTime @default(now())

  @@index([employeeId, date])
}

/** A sanitation/cleaning SOP -- equipment/area, chemicals, step-by-step
 * procedure, frequency, and the role generally responsible. Reference
 * documentation, reused across many scheduled assignments. */
model SanitationProcedure {
  id             String   @id @default(cuid())
  name           String
  areaEquipment  String
  chemicals      String
  steps          String
  frequency      String
  responsibleRole String
  riskLevel      RiskLevel @default(MEDIUM)
  // Which operation day this duty is scheduled on -- BOTH covers duties that
  // apply regardless of whether it's a Cooking or Jar Filling day (and are
  // the only ones auto-scheduled on a day-off).
  appliesTo      SanitationScope @default(BOTH)
  // When this duty is due at the kiosk: PRE_COOKING gates the lunch-break
  // punch, POST_COOKING gates Time Out, ANYTIME shows after any punch.
  timing         SanitationTiming @default(ANYTIME)
  // Optional pay incentive for whoever does this duty. Never shown at the
  // kiosk; it is only suggested to admins on payroll once a supervisor has
  // passed the inspection.
  bonusAmount    Decimal? @db.Decimal(10, 2)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assignments SanitationAssignment[]
}

enum SanitationTiming {
  PRE_COOKING
  POST_COOKING
  ANYTIME
}

enum SanitationScope {
  COOKING
  JAR_FILLING
  BOTH
}

/** One scheduled occurrence of a SanitationProcedure for one date, done as a
 * team rather than pre-assigned to one person. employeeId is left unset at
 * creation and filled in by whichever active employee taps it complete at
 * the kiosk (self-claim) -- that's who is accountable if the inspection
 * below fails. The employee's tap alone isn't proof, so a supervisor then
 * independently inspects it (inspectionResult) -- these are deliberately
 * separate fields. */
model SanitationAssignment {
  id          String                     @id @default(cuid())
  procedureId String
  procedure   SanitationProcedure        @relation(fields: [procedureId], references: [id])
  employeeId  String?
  employee    Employee?                  @relation(fields: [employeeId], references: [id])
  date        DateTime                   @db.Date
  status      SanitationAssignmentStatus @default(PENDING)
  completedAt DateTime?

  assignedByAdminId String?
  assignedByAdmin   AdminUser? @relation("SanitationAssignmentAssignedByAdmin", fields: [assignedByAdminId], references: [id])

  inspectedByAdminId String?
  inspectedByAdmin   AdminUser?        @relation("SanitationAssignmentInspectedByAdmin", fields: [inspectedByAdminId], references: [id])
  inspectedAt        DateTime?
  inspectionResult   InspectionResult?
  inspectionNote     String?

  /** Set once an admin turns this duty's bonus into a real PayslipAdjustment, so it can never be applied twice. */
  payslipAdjustmentId String?            @unique
  payslipAdjustment   PayslipAdjustment? @relation(fields: [payslipAdjustmentId], references: [id])
  /** True once an admin has declined this duty's bonus, so it stops being suggested. */
  bonusDismissed      Boolean            @default(false)

  createdAt DateTime @default(now())

  @@index([employeeId, date])
  @@index([date])
}
